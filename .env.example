# The private key of the wallet you'll deploy from. NEVER put a real
# mainnet wallet's key here - create a fresh MetaMask account just for
# testnet work. Export it from MetaMask: Account details > Show private key.
PRIVATE_KEY=

# Optional - a custom Amoy RPC URL (e.g. from Alchemy/Infura). The public
# default in hardhat.config.js works fine for a demo.
AMOY_RPC_URL=
